# Copy to .env for local development, and set the same variables in your
# hosting provider's dashboard for Production. A missing GROQ key does not
# fail loudly in the browser — voice silently degrades — so verify these
# are present in every deployed environment.

# --- AI (Groq) ---
# Used for chat, text-to-speech, and Whisper transcription.
# NOTE: Groq rate limits are per-organization, so additional keys do NOT
# multiply your quota. One key is sufficient.
GROQ_API_KEY=

# Optional overrides. Each falls back to GROQ_API_KEY when unset.
GROQ_VOICE_API_KEY=
GROQ_CHAT_API_KEY=

# --- Database ---
MONGODB_URI=

# --- Auth ---
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- App ---
# Public base URL, e.g. https://chapterchat.example.com
NEXT_PUBLIC_APP_URL=
